{
  "name": "lombokencryptdecrypt",
  "version": "0.1.0",
  "description": "Encrypt/decrypt toolkit for TypeScript \u2014 pre-release. Pure-TS, zero runtime dependencies.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "codinglombok <codinglombok@gmail.com>",
  "homepage": "https://github.com/codinglombok/LombokEncryptDecrypt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codinglombok/LombokEncryptDecrypt.git"
  },
  "bugs": {
    "url": "https://github.com/codinglombok/LombokEncryptDecrypt/issues"
  },
  "keywords": [
    "encrypt",
    "decrypt",
    "cryptography",
    "aes",
    "chacha20",
    "aead",
    "sha3",
    "blake3",
    "sm3",
    "sm4",
    "ed25519",
    "ecdh",
    "hkdf",
    "keystore",
    "lombok"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./symmetric": {
      "types": "./dist/symmetric/index.d.ts",
      "import": "./dist/symmetric/index.js"
    },
    "./asymmetric": {
      "types": "./dist/asymmetric/index.d.ts",
      "import": "./dist/asymmetric/index.js"
    },
    "./hash": {
      "types": "./dist/hash/index.d.ts",
      "import": "./dist/hash/index.js"
    },
    "./mac": {
      "types": "./dist/mac/index.d.ts",
      "import": "./dist/mac/index.js"
    },
    "./kdf": {
      "types": "./dist/kdf/index.d.ts",
      "import": "./dist/kdf/index.js"
    },
    "./keystore": {
      "types": "./dist/keystore/index.d.ts",
      "import": "./dist/keystore/index.js"
    },
    "./stream": {
      "types": "./dist/stream/index.d.ts",
      "import": "./dist/stream/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'benches/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:vectors": "jest tests/vectors",
    "test:watch": "jest --watch",
    "build": "npm run build:ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','coverage'])fs.rmSync(d,{recursive:true,force:true})\"",
    "generate:vectors": "tsx scripts/generate-vectors.ts",
    "bench": "tsx benches/bench_aes_gcm.ts",
    "bench:all": "tsx benches/bench_aes_gcm.ts && tsx benches/bench_sha.ts && tsx benches/bench_streaming.ts && tsx benches/bench_ed25519.ts",
    "docs": "typedoc src/index.ts",
    "prepack": "npm run build:ts"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.3.2",
    "release-please": "^17.11.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.15.7",
    "typedoc": "^0.26.11",
    "typescript": "~5.6.3"
  },
  "optionalDependencies": {
    "lombokvector": "^0.1.0",
    "lomboksimhash": "^0.1.0"
  }
}
