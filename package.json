{
  "name": "lombokencryptdecrypt",
  "version": "0.1.0",
  "description": "Universal encrypt/decrypt library \u2014 AES/ChaCha20/Kyber/Dilithium/SPHINCS+/SM2/SM3/SM4/ZUC/SNOW3G/HSM/TPM \u2014 12 languages, post-quantum ready, Apache 2.0",
  "license": "Apache-2.0",
  "author": "codinglombok <codinglombok@gmail.com>",
  "homepage": "https://github.com/codinglombok/LombokEncryptDecrypt#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/codinglombok/LombokEncryptDecrypt.git"
  },
  "bugs": {
    "url": "https://github.com/codinglombok/LombokEncryptDecrypt/issues"
  },
  "keywords": [
    "encrypt",
    "decrypt",
    "cryptography",
    "aes",
    "chacha20",
    "sha256",
    "blake3",
    "post-quantum",
    "kyber",
    "dilithium",
    "sphincs",
    "falcon",
    "ml-kem",
    "ml-dsa",
    "ecdh",
    "ecdsa",
    "ed25519",
    "rsa",
    "hkdf",
    "argon2",
    "pbkdf2",
    "sm2",
    "sm3",
    "sm4",
    "zuc",
    "snow3g",
    "5g",
    "lte",
    "hsm",
    "pkcs11",
    "tpm",
    "sgx",
    "secure-enclave",
    "hpke",
    "ecies",
    "envelope-encryption",
    "key-management",
    "format-preserving-encryption",
    "fpe",
    "ff1",
    "xts",
    "audit-log",
    "fips",
    "nist",
    "pqc",
    "lombok",
    "lombok-ecosystem",
    "wasm",
    "zero-dep",
    "typescript",
    "rust"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    },
    "./symmetric": {
      "types": "./dist/types/symmetric.d.ts",
      "import": "./dist/esm/symmetric.js"
    },
    "./asymmetric": {
      "types": "./dist/types/asymmetric.d.ts",
      "import": "./dist/esm/asymmetric.js"
    },
    "./hash": {
      "types": "./dist/types/hash.d.ts",
      "import": "./dist/esm/hash.js"
    },
    "./mac": {
      "types": "./dist/types/mac.d.ts",
      "import": "./dist/esm/mac.js"
    },
    "./kdf": {
      "types": "./dist/types/kdf.d.ts",
      "import": "./dist/esm/kdf.js"
    },
    "./keystore": {
      "types": "./dist/types/keystore.d.ts",
      "import": "./dist/esm/keystore.js"
    },
    "./stream": {
      "types": "./dist/types/stream.d.ts",
      "import": "./dist/esm/stream.js"
    },
    "./audit": {
      "types": "./dist/types/audit.d.ts",
      "import": "./dist/esm/audit.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "src-rust/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:cjs",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:cjs": "tsx scripts/bundle-cjs.ts",
    "build:wasm": "cd src-rust && wasm-pack build --target web --out-dir ../dist/wasm",
    "build:native": "cargo build --release && napi build --platform --release",
    "clean": "rm -rf dist/",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:vectors": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/vectors --runInBand",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/integration --runInBand",
    "test:fuzz": "node scripts/run-fuzz.mjs",
    "test:dudect": "node scripts/run-dudect.mjs",
    "lint": "eslint src/ tests/ --max-warnings 0",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bench": "tsx benches/bench_aes_gcm.ts",
    "bench:all": "tsx scripts/run-all-benches.ts",
    "audit:npm": "npm audit --audit-level=moderate",
    "audit:cargo": "cargo audit",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "release": "release-please release-pr",
    "docs:api": "typedoc src/index.ts --out docs/api"
  },
  "optionalDependencies": {
    "lombokqrcode": "^0.2.0",
    "lomboksimhash": "^0.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "release-please": "^16.10.0",
    "ts-jest": "^29.1.5",
    "tsx": "^4.15.7",
    "typedoc": "^0.26.11",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
