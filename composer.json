{
  "name": "codinglombok/lombokencryptdecrypt",
  "description": "Universal encrypt/decrypt library — AES/ChaCha20/Kyber/Dilithium/SPHINCS+/SM2/SM3/SM4/ZUC/SNOW3G — post-quantum ready, Apache 2.0",
  "type": "library",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "authors": [
    {
      "name": "codinglombok",
      "email": "codinglombok@gmail.com",
      "homepage": "https://github.com/codinglombok"
    }
  ],
  "homepage": "https://github.com/codinglombok/LombokEncryptDecrypt",
  "support": {
    "issues": "https://github.com/codinglombok/LombokEncryptDecrypt/issues",
    "source": "https://github.com/codinglombok/LombokEncryptDecrypt"
  },
  "keywords": [
    "encrypt", "decrypt", "cryptography", "aes", "chacha20",
    "post-quantum", "kyber", "dilithium", "sphincs",
    "ecdh", "ecdsa", "ed25519", "rsa", "hkdf", "argon2",
    "sm2", "sm3", "sm4", "lombok"
  ],
  "require": {
    "php": ">=8.2",
    "ext-openssl": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.11 || ^2.0",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "CodingLombok\\LombokEncryptDecrypt\\": "ports/php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CodingLombok\\LombokEncryptDecrypt\\Tests\\": "ports/php/tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse ports/php/src --level=9",
    "cs-check": "phpcs --standard=PSR12 ports/php/src",
    "cs-fix": "phpcbf --standard=PSR12 ports/php/src"
  }
}
