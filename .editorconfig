root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{ts,tsx,js,mjs,cjs}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{rs}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{py}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{go}]
indent_style = tab
indent_size = 4

[*.{php}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{java,kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{cs}]
indent_style = space
indent_size = 4

[*.{swift}]
indent_style = space
indent_size = 4

[*.{cpp,h,hpp,c}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{pl,pm}]
indent_style = space
indent_size = 4

[*.{sql}]
indent_style = space
indent_size = 4

[*.{toml,yaml,yml}]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
